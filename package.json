{
  "name": "agent-context-gateway",
  "version": "0.2.1",
  "description": "Search what your coding agents already did: federated retrieval over native Claude Code, Codex, Cursor and OpenCode histories, with provenance.",
  "keywords": [
    "agents",
    "claude-code",
    "codex",
    "mcp",
    "search",
    "context",
    "retrieval"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/20023136kelyan/agent-context-gateway.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "bin": {
    "acg": "dist/bin.js",
    "agent-context-gateway": "dist/bin.js"
  },
  "main": "dist/app.js",
  "types": "dist/app.d.ts",
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "README.md",
    "LICENSE",
    ".env.example"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "node --env-file-if-exists=.env --import tsx src/cli.ts",
    "test": "vitest run",
    "eval": "node --env-file-if-exists=.env --import tsx scripts/run-eval.ts",
    "sweep": "node --env-file-if-exists=.env --import tsx scripts/sweep.ts",
    "lint": "eslint src --ext .ts",
    "sync": "node --env-file-if-exists=.env --import tsx src/cli.ts sync",
    "setup:native": "python3 scripts/fetch-native-binding.py",
    "eval:proactive": "node --env-file-if-exists=.env --import tsx scripts/eval-proactive.ts",
    "prepack": "npm run build",
    "eval:outcomes": "tsx scripts/eval-outcomes.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@pngwasi/node-tantivy-binding": "^0.3.4",
    "bonjour-service": "^1.4.4",
    "commander": "^12.0.0",
    "fastify": "^5.0.0",
    "sqlite-vec": "^0.1.9",
    "zod": "^3.23.0"
  },
  "optionalDependencies": {
    "@lancedb/lancedb": "^0.38.0",
    "@pngwasi/node-tantivy-binding-darwin-arm64": "^0.3.4",
    "@pngwasi/node-tantivy-binding-darwin-x64": "^0.3.4",
    "@pngwasi/node-tantivy-binding-linux-x64-gnu": "^0.3.4"
  },
  "devDependencies": {
    "@types/node": "^24.13.4",
    "eslint": "^9.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.5.0",
    "vitest": "^5.0.1"
  },
  "overrides": {
    "sharp": "^0.35.4",
    "onnxruntime-web": "^1.23.2"
  },
  "author": ""
}
