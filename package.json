{
  "name": "bifrost",
  "version": "0.3.0",
  "description": "Bifröst: a work layer that delivers what agents learned, decided and were told at the place in the code where it applies",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "exp:run": "node --env-file-if-exists=.env --import tsx experiments/upper-bound/harness/run.ts",
    "exp:generate": "node --env-file-if-exists=.env --import tsx experiments/upper-bound/harness/generate.ts",
    "exp:report": "node --import tsx experiments/upper-bound/harness/report.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "commander": "^12.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@types/node": "^24.13.4",
    "tsx": "^4.7.0",
    "typescript": "^5.5.0",
    "vitest": "^5.0.1"
  },
  "main": "index.js",
  "directories": {
    "test": "tests"
  },
  "keywords": [],
  "author": "",
  "license": "ISC"
}
