# Copy to .env and fill in. .env is git-ignored; this template must never hold real keys.
# Loaded by `npm run dev|sync|eval` and gateway.sh via node --env-file-if-exists.
# Nothing here is required: with no keys set the gateway runs lexical-only.

# --- Embeddings -------------------------------------------------------------
# Remote. Setting this key is the opt-in that sends turn text off-machine,
# a deliberate departure from spec §73 Principle 5 (local-first).
VOYAGE_API_KEY=
# Model and width are configuration because several Voyage models share a width
# and a wrong pairing would write a foreign vector space into a valid-looking
# table. The provider asserts the returned width matches and throws if not.
# VOYAGE_MODEL=voyage-4
# VOYAGE_DIM=1024
# VOYAGE_CODE_MODEL=voyage-code-4
# VOYAGE_CODE_DIM=1024
# VOYAGE_TIMEOUT_MS=30000

# Pin one engine: voyage | voyage-code | voyage-context (default: voyage).
# A pinned engine never falls back, so one corpus cannot scatter across tables.
# GATEWAY_EMBED_ENGINE=voyage

# --- Key proxy ------------------------------------------------------------
# Instead of your own VOYAGE_API_KEY / TYPESAFE_API_KEY, use a key proxy's key.
# Your own key still wins for any vendor you hold one for. No default URL.
# ACG_PROXY_URL=https://proxy.example.com
# ACG_PROXY_KEY=acgp_...

# --- Scrubbing --------------------------------------------------------------
# Everything sent to Voyage or Jev is scrubbed first: API keys and tokens,
# private keys, JWTs, bearer/basic auth, URL passwords and named credentials
# (`*_PASSWORD=`, `"api_key": "…"`). The local index keeps history verbatim.
#   all      (default) secrets + emails + non-loopback IPv4
#   secrets  secrets only; emails and IPs are sent as written
#   off      send verbatim — for measuring scrubbing's effect, not real use
# GATEWAY_SCRUB=all

# --- Vector storage ---------------------------------------------------------
# lance | sqlite. Default probes for the LanceDB native addon and uses
# sqlite-vec when it is absent, which is always the case on darwin-x64
# (LanceDB dropped Intel macOS after 0.22.3).
# GATEWAY_VECTOR_BACKEND=sqlite

# --- Jev / TypeSafe ---------------------------------------------------------
# Reranking. Setting this key makes Jev the selected reranker AND the selected
# decision judge. With Jev selected, reranking is ON by default on every
# transport (Voyage and none default OFF): measured on the
# 72-session fixture corpus, hybrid 0.699 -> jev-pairwise 0.968 NDCG@5, and the
# Jev judge takes decision citations from Hit@1 0.381 to 0.952.
#
# It costs ~450ms per search and sends query text plus candidate excerpts
# off-machine. Turn it off per request (`?rerank=false`, `--no-rerank`,
# `rerank: false`) or system-wide with GATEWAY_RERANKER=none.
TYPESAFE_API_KEY=

# Pin one reranker instead of the default order (jev -> voyage -> none). A pin
# never falls back, so a deployment cannot silently switch vendors. jev is the
# locked reranker (src/components.ts); voyage is pin-only until measured.
# GATEWAY_RERANKER=voyage
# Decision judge: jev | heuristic (default: jev when TYPESAFE_API_KEY is set).
# GATEWAY_JUDGE=jev
# JEV_MODEL=jev-latest
# JEV_TIMEOUT_MS=30000

# --- Retrieval tuning -------------------------------------------------------
# These three are ENGINE-CALIBRATED. The defaults are swept for voyage-4; a
# different embedding model will want a different floor, and getting it wrong
# is silent — a too-high floor multiplies rank-1 semantic hits to zero weight
# rather than dropping them visibly. Re-sweep with `npm run eval -- --fixture`
# before trusting a new engine.
#
# Confidence ramp applied to the vector side of RRF: weight rises from 0 at
# FLOOR to 1 at FLOOR+SPAN. voyage-4 paraphrase hits measure 0.35-0.57.
# GATEWAY_SIM_FLOOR=0.15
# GATEWAY_SIM_SPAN=0.35
# Hard gate: vector hits below this similarity never enter the pool at all.
# GATEWAY_MIN_VECTOR_SIM=0.25
# Candidates the reranker scores. 30 is the knee; 50 costs ~320ms for nothing.
# GATEWAY_RERANK_POOL=30

# --- Gateway server ---------------------------------------------------------
# Required to bind anything other than loopback; --host refuses without it.
# Generate with: openssl rand -hex 32
GATEWAY_TOKEN=
# GATEWAY_PORT=3000
# GATEWAY_ALLOWED_HOSTS=
# CONTEXT_GATEWAY_STATE=
# Everything below is also settable in <stateDir>/settings.json, which env
# deliberately outranks. Order: CLI flag > env > settings.json > default.
# GATEWAY_BACKEND=tantivy
# GATEWAY_INDEX_DIR=
# GATEWAY_VECTOR_DIR=
